# =============================================================================
# Sao chép file này thành `.env` và điền giá trị thật.
# Tuyệt đối KHÔNG commit `.env` lên git.
# =============================================================================

# --- App ---
ENV=dev
LOG_LEVEL=INFO
# Secret cho JWT signing. Sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-please-generate-a-secure-key-of-at-least-32-bytes

# --- Postgres (app DB) ---
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag-strong-password-change-me
POSTGRES_PORT=5432

# DB phụ cho Langfuse, dùng cùng Postgres
LANGFUSE_DB=langfuse

# --- Redis ---
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# --- Qdrant ---
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Nếu để trống, Qdrant không yêu cầu auth (chỉ OK trong network nội bộ Docker)
QDRANT_API_KEY=

# --- MinIO (object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio-strong-password-change-me
MINIO_BUCKET=rag-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- LLM (Gemini qua OpenAI-compatible endpoint) ---
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL_DEFAULT=gemini-2.5-flash
LLM_MODEL_HEAVY=gemini-2.5-pro

# --- Embedding ---
# Gemini Embedding API qua OpenAI endpoint
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Rerank ---
# rerank_provider: "cohere" (mặc định) hoặc "llm" (Gemini LLM-as-reranker).
# Khi "cohere" mà gọi lỗi (quota/timeout/key sai) -> tự fallback sang "llm".
RERANK_PROVIDER=cohere
COHERE_API_KEY=your-cohere-api-key-here
COHERE_RERANK_MODEL=rerank-v3.5

# --- Langfuse ---
# Sinh các giá trị này (xem README):
#   openssl rand -hex 32
LANGFUSE_SALT=replace-with-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_WEB_PORT=3000
# Sau khi đăng nhập Langfuse UI lần đầu, tạo project + lấy keys điền vào đây
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- ClickHouse (Langfuse backing) ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse-strong-password-change-me

# --- Scaling ---
API_REPLICAS=2
WORKER_REPLICAS=2
API_WORKERS=2   # gunicorn workers per replica

# --- Public ---
HTTP_PORT=80
